<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.richfield.smartpantry"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <permission
        android:name="com.richfield.smartpantry.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.richfield.smartpantry.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_pantry"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_pantry"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.SmartPantryManager" >

        <!-- Main Screen: Pantry Inventory -->
        <activity
            android:name="com.richfield.smartpantry.activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add or Edit Ingredient Screen -->
        <activity
            android:name="com.richfield.smartpantry.activity.AddEditIngredientActivity"
            android:exported="false"
            android:parentActivityName="com.richfield.smartpantry.activity.MainActivity" />

        <!-- Suggested Recipes Screen (Strict-Matching Algorithm) -->
        <activity
            android:name="com.richfield.smartpantry.activity.SuggestedRecipesActivity"
            android:exported="false"
            android:label="Suggested Recipes"
            android:parentActivityName="com.richfield.smartpantry.activity.MainActivity" />

        <!-- Recipe Detail Screen -->
        <activity
            android:name="com.richfield.smartpantry.activity.RecipeDetailActivity"
            android:exported="false"
            android:label="Recipe Details"
            android:parentActivityName="com.richfield.smartpantry.activity.SuggestedRecipesActivity" />

        <!-- Settings & Configuration Screen -->
        <activity
            android:name="com.richfield.smartpantry.activity.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName="com.richfield.smartpantry.activity.MainActivity" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.richfield.smartpantry.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>